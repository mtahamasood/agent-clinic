# AgentClinic environment.
#
# Copy to `.env` and you are done — the local path needs nothing else.
#   cp .env.example .env

# Self-hosted: a libSQL file on disk, created by `npm run migrate`.
DATABASE_URL="file:./clinic.db"

# Vercel / Turso: point at the hosted database instead, and set the token below.
#   DATABASE_URL="libsql://your-database.turso.io"

# Remote only. Leave unset for the local file — libSQL does not authenticate it.
# DATABASE_AUTH_TOKEN=""
